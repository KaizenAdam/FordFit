---
// A GHL (LeadConnector) form embed. Submissions go to GHL, so it works only while the GHL
// account stays active.
const { id, name, height = 500, ...rest } = Astro.props;
---
<iframe
  src={`https://api.leadconnectorhq.com/widget/form/${id}`}
  style={`width:100%;height:${height}px;border:none;border-radius:3px`}
  id={`inline-${id}`}
  data-layout="{'id':'INLINE'}"
  data-trigger-type="alwaysShow"
  data-trigger-value=""
  data-activation-type="alwaysActivated"
  data-activation-value=""
  data-deactivation-type="neverDeactivate"
  data-deactivation-value=""
  data-form-name={name}
  data-height={height}
  data-layout-iframe-id={`inline-${id}`}
  data-form-id={id}
  title={name}
  loading="lazy"
  {...rest}
></iframe>
<script is:inline src="https://link.msgsndr.com/js/form_embed.js"></script>
