---
// Tinder-style stack of photos: drag the top card left or right to see the next (GHL custom code).
const { images } = Astro.props;
---
<div class="swipe" data-swipe data-images={JSON.stringify(images)}>
  {images.slice(0, 3).reverse().map((src, i) => (
    <div class="swipe-card" style={i === 0 ? 'transform:translateY(20px) scale(.96)' : i === 1 ? 'transform:translateY(10px) scale(.98)' : ''}>
      <img src={src} alt="FordFit clients training together" draggable="false" />
    </div>
  ))}
</div>
<p class="swipe-hint">Swipe or drag the photo</p>

<style>
  .swipe { width: 320px; height: 400px; margin: 0 auto; position: relative; touch-action: pan-y; }
  .swipe-card {
    position: absolute; inset: 0; border-radius: 18px; overflow: hidden; background: #111;
    box-shadow: 0 12px 40px rgba(0, 0, 0, .3); cursor: grab; will-change: transform;
  }
  .swipe-card img { width: 100%; height: 100%; object-fit: cover; user-select: none; pointer-events: none; }
  .swipe-hint { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
  @media (max-width: 480px) { .swipe { width: 60vw; height: calc(60vw * 1.25); } }
</style>

<script>
  document.querySelectorAll('[data-swipe]').forEach((stack) => {
    const images = JSON.parse(stack.dataset.images);
    let next = 3;
    const make = (src) => {
      const card = document.createElement('div');
      card.className = 'swipe-card';
      card.innerHTML = `<img src="${src}" alt="FordFit clients training together" draggable="false">`;
      return card;
    };
    const restack = () => {
      const cards = stack.querySelectorAll('.swipe-card');
      cards.forEach((c) => (c.style.transform = ''));
      if (cards[0]) cards[0].style.transform = 'translateY(20px) scale(.96)';
      if (cards[1]) cards[1].style.transform = 'translateY(10px) scale(.98)';
    };
    const bind = () => {
      const cards = stack.querySelectorAll('.swipe-card');
      const top = cards[cards.length - 1];
      if (!top) return;
      let sx = 0, sy = 0, dx = 0, dy = 0, dragging = false;
      top.addEventListener('pointerdown', (e) => {
        dragging = true; sx = e.clientX; sy = e.clientY; dx = dy = 0;
        top.style.transition = 'none';
        top.setPointerCapture(e.pointerId);
      });
      top.addEventListener('pointermove', (e) => {
        if (!dragging) return;
        dx = e.clientX - sx; dy = e.clientY - sy;
        top.style.transform = `translate(${dx}px, ${dy}px) rotate(${dx * 0.05}deg)`;
      });
      const end = () => {
        if (!dragging) return;
        dragging = false;
        if (Math.abs(dx) > 90) {
          top.style.transition = 'transform .25s ease-out';
          top.style.transform = `translate(${dx > 0 ? innerWidth : -innerWidth}px, ${dy}px) rotate(${dx * 0.1}deg)`;
          setTimeout(() => {
            top.remove();
            stack.insertBefore(make(images[next++ % images.length]), stack.firstChild);
            restack();
            bind();
          }, 250);
        } else {
          top.style.transition = 'transform .2s ease-out';
          top.style.transform = '';
        }
      };
      top.addEventListener('pointerup', end);
      top.addEventListener('pointercancel', end);
    };
    bind();
  });
</script>
