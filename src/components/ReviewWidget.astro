---
// Google reviews widget from GHL Reputation (reputationhub.site). It keeps working only
// while the GHL sub-account and its Reputation feature stay active.
// Without a widgetId it shows the account's default widget.
const { widgetId } = Astro.props;
const base = 'https://reputationhub.site/reputation/widgets/review_widget/tvz9kWDCjLJnKJ7sWuzO';
const src = widgetId ? `${base}?widgetId=${widgetId}` : base;
---
<script is:inline src="https://reputationhub.site/reputation/assets/review-widget.js"></script>
<iframe class="lc_reviews_widget" src={src} title="FordFit Google reviews" frameborder="0" scrolling="no" style="min-width: 100%; width: 100%;"></iframe>
