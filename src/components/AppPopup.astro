---
// "7 day free trial" popup with the free trial form. Opens 8 seconds after the page loads,
// once per visit, as on GHL.
import LeadForm from './LeadForm.astro';
---
<dialog class="popup" id="app-popup" aria-labelledby="popup-title">
  <button type="button" class="popup-close" aria-label="Close" data-close>&times;</button>
  <div class="popup-head">
    <img src="/assets/img/fordfit-icon.png" alt="" width="120" height="120" />
    <div>
      <h2 id="popup-title">7 DAY FREE TRIAL</h2>
      <p>Get access to the FordFit App - track your workouts, meals, habits and more!</p>
    </div>
  </div>
  <LeadForm form="trial" />
</dialog>

<style>
  .popup {
    width: min(560px, calc(100vw - 32px)); max-height: calc(100dvh - 40px); padding: 36px 36px 28px; margin: auto;
    background: var(--white); border: 0; border-radius: 20px; box-shadow: 0 24px 60px rgba(0, 0, 0, .3);
  }
  .popup::backdrop { background: rgba(0, 0, 0, .6); backdrop-filter: blur(2px); }
  .popup-close {
    position: absolute; top: 14px; right: 14px; width: 36px; height: 36px; border-radius: 50%;
    display: grid; place-items: center; font-size: 24px; line-height: 1; background: var(--smoke); transition: background .15s ease;
  }
  .popup-close:hover { background: #e6e6e6; }
  .popup-head { display: grid; grid-template-columns: 76px 1fr; align-items: center; gap: 18px; margin-bottom: 22px; padding-right: 30px; }
  .popup-head img { width: 76px; height: 76px; }
  .popup-head h2 { font-family: var(--poppins); font-size: 28px; font-weight: 700; line-height: 1.15; letter-spacing: .5px; }
  .popup-head p { font-family: var(--open-sans); font-size: 15px; line-height: 1.45; color: var(--slate); margin-top: 6px; }
  @media (max-width: 480px) {
    .popup { padding: 28px 20px 20px; }
    .popup-head { grid-template-columns: 56px 1fr; gap: 14px; }
    .popup-head img { width: 56px; height: 56px; }
    .popup-head h2 { font-size: 22px; }
    .popup-head p { font-size: 13px; }
  }
</style>

<script>
  const popup = document.getElementById('app-popup');
  const KEY = 'ff-app-popup-seen';
  let seen = false;
  try { seen = sessionStorage.getItem(KEY) === '1'; } catch {}
  // Coming back from the no-JS form fallback: reopen so the thank-you (or error) shows.
  if (popup && location.hash === '#trial-form') popup.showModal();
  else if (popup && !seen) {
    setTimeout(() => {
      popup.showModal();
      try { sessionStorage.setItem(KEY, '1'); } catch {}
    }, 8000);
  }
  popup?.querySelector('[data-close]')?.addEventListener('click', () => popup.close());
  popup?.addEventListener('click', (e) => { if (e.target === popup) popup.close(); });
</script>
