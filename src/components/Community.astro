---
// Two columns: media on the left (slot "media"), heading, text and a button that scrolls to the reviews.
const { title, text, bg = 'var(--white)', video, size = 35 } = Astro.props;
---
<section class="community" style={`background:${bg}`}>
  {video && (
    <video class="bg-video" autoplay muted loop playsinline preload="metadata" poster={`/assets/img/${video}-poster.webp`} aria-hidden="true">
      <source src={`/assets/video/${video}.mp4`} type="video/mp4" />
    </video>
  )}
  <div class="container community-grid">
    <div class="community-media"><slot name="media" /></div>
    <div class="community-copy">
      <h2 style={`font-size:${size}px`}>{title}</h2>
      <p>{text}</p>
      <a class="btn btn-community" href="#reviews">READ ABOUT THEIR TRANSFORMATIONS</a>
    </div>
  </div>
</section>

<style>
  .community { position: relative; overflow: hidden; border-top: 3px solid var(--black); padding: 30px 0; }
  .community-grid { position: relative; z-index: 1; display: grid; grid-template-columns: 1fr 1fr; gap: 10px; align-items: center; min-height: 340px; }
  .community-copy { text-align: center; padding: 10px 5px; }
  .community-copy h2 { font-family: var(--poppins); font-weight: 700; line-height: 1.3; text-transform: uppercase; text-wrap: balance; }
  .community-copy p { font-family: var(--open-sans); font-size: 16px; font-weight: 500; line-height: 1.3; margin: 22px 0 30px; }
  .btn-community {
    width: 100%; background: var(--black); color: var(--white); border: 2px solid var(--white); border-radius: 15px;
    font-size: 20px; font-weight: 600; padding: 15px 20px;
  }
  @media (max-width: 767px) {
    .community-grid { grid-template-columns: 1fr; gap: 24px; }
    .community-copy h2 { font-size: 26px !important; }
    .btn-community { font-size: 16px; }
  }
</style>
