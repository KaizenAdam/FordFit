---
import Base from '../layouts/Base.astro';
import Reviews from '../components/Reviews.astro';
import StoryGallery from '../components/StoryGallery.astro';
import AppPromo from '../components/AppPromo.astro';
import { START_URL } from '../site.js';

const images = [1, 2, 3, 4, 5, 6].map((n) => `/assets/img/about-${n}.webp`);
---
<Base
  title="About Toby Forder | FordFit Personal Trainer & Coach"
  description="Learn about Toby Forder, the personal trainer behind FordFit. With tailored coaching and a results-driven approach."
>
  <section class="about-intro">
    <div class="container">
      <StoryGallery images={images} headingTag="h1" />
      <div class="about-cta"><a class="btn btn-black" href={START_URL}>MAKE. A. DIFFERENCE.</a></div>
    </div>
  </section>

  <section class="proof-section">
    <div class="container">
      <p class="proof-kicker">NEED MORE CONVINCING?</p>
      <h2 class="proof-title">PROOF THAT EFFORT PAYS OFF</h2>
      <p class="proof-intro">Every five-star review tells a story of consistency, confidence, and progress. Behind each one is someone who committed to change — from first-time gym-goers to seasoned athletes. At FordFit, these transformations aren’t luck; they’re the result of expert coaching, accountability, and a community that keeps you pushing forward. These are the real results behind FordFit.</p>
      <div class="review-widget"><Reviews variant="masonry" /></div>
    </div>
  </section>

  <AppPromo
    kicker="Personal Training Made Simple with the FordFit App"
    lines={['PERSONAL', 'TRAINING IN', 'YOUR POCKET']}
    size={72}
    bodyFont="inter"
    text="The FordFit App brings your training, nutrition, and progress tracking together — helping you stay consistent whether you’re in the gym, at home, or on the go."
    cta="START YOUR JOURNEY"
    href={START_URL}
  />
</Base>
