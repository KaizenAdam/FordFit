---
import Base from '../layouts/Base.astro';
import GhlForm from '../components/GhlForm.astro';
import ReviewWidget from '../components/ReviewWidget.astro';

const strip = Array.from({ length: 11 }, (_, i) => `/assets/img/strip-${i + 1}.webp`);
---
<Base
  title="Start Your Journey | FordFit Personal Training"
  description="Tell Toby what you’re looking for and he’ll be in touch to book your consultation and plan your training."
>
  <section class="sj">
    <div class="container">
      <h1 class="sj-title">YOUR TRANSFORMATION <br />STARTS WITH A <u><em>SINGLE CLICK</em></u></h1>
      <p class="sj-sub">Once you fill out this form, Toby will get in touch to book your consultation and talk through the best plan for your goals.</p>

      <div class="sj-grid">
        <!-- TODO: GHL form "FORDFIT 1". Replace with a FordFit-owned form before leaving GHL. -->
        <div class="sj-form"><GhlForm id="jK35KKrVIRg2JpqscTv2" name="FORDFIT 1" height={560} /></div>
        <div class="sj-reviews"><ReviewWidget widgetId="6917121c169c61da93d97ac0" /></div>
      </div>

      <div class="strip" aria-label="Toby coaching FordFit clients">
        <div class="strip-track">
          {[...strip, ...strip].map((src, i) => (
            <div class="strip-item"><img src={src} alt="" width="720" height="900" loading="lazy" aria-hidden={i >= strip.length ? 'true' : undefined} /></div>
          ))}
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .sj { background: var(--smoke); padding: 60px 0 60px; }
  .sj-title { font-family: var(--poppins); font-size: 50px; font-weight: 700; line-height: 1.3; text-align: center; }
  .sj-title u { text-underline-offset: 6px; text-decoration-thickness: 3px; }
  .sj-sub { font-family: var(--open-sans); font-size: 16px; line-height: 1.3; text-align: center; margin-top: 14px; }
  .sj-grid { display: grid; grid-template-columns: 455px 1fr; gap: 40px; align-items: start; max-width: 1080px; margin: 50px auto 0; }
  .sj-form { background: var(--white); box-shadow: 0 2px 10px rgba(0, 0, 0, .12); padding: 20px 10px; }
  .sj-reviews { min-width: 0; }

  .strip { max-width: 1060px; margin: 60px auto 0; overflow: hidden; --per-view: 3; }
  .strip-track { display: flex; gap: .35rem; width: max-content; animation: strip-scroll 30s linear infinite; }
  .strip:hover .strip-track { animation-play-state: paused; }
  .strip-item { width: calc((min(1060px, 100vw - 30px) - .7rem) / var(--per-view)); flex: none; }
  .strip-item img { width: 100%; height: auto; aspect-ratio: 4 / 5; object-fit: cover; border-radius: 14px; }
  @keyframes strip-scroll { to { transform: translateX(-50%); } }
  @media (prefers-reduced-motion: reduce) { .strip-track { animation: none; } }

  @media (max-width: 900px) {
    .sj-grid { grid-template-columns: 1fr; max-width: 520px; }
    .strip { --per-view: 2; }
  }
  @media (max-width: 767px) {
    .sj { padding: 40px 0; }
    .sj-title { font-size: 30px; }
  }
</style>
