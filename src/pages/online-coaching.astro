---
import Base from '../layouts/Base.astro';
import ReviewsBand from '../components/ReviewsBand.astro';
import StoryGallery from '../components/StoryGallery.astro';
import { START_URL } from '../site.js';

const rows = [
  ['Online Coaching Plan', 'One personalised plan you can follow independently', 'A fully tailored plan reviewed and adjusted every month.'],
  ['Technical Guidance & Form Coaching', 'Access to tutorial videos and form demos directly inside the FordFit App.', 'Weekly 1-to-1 video check-ins with Toby for technique and progress review.'],
  ['Nutrition & Lifestyle Support', 'Built-in calorie, water, and habit tracking to support healthier routines.', 'A tailored meal plan with ongoing nutrition guidance and lifestyle coaching.'],
  ['Goal Orientation', 'A custom plan designed around your primary fitness goal.', 'A phase-based program built to guide you step by step toward your long-term goal.'],
  ['Progress Tracking & Accountability', '', 'Weekly feedback, progress reviews, and accountability check-ins directly with Toby.'],
];
const plans = [
  { name: 'Basic Package', caption: 'Steady, consistent progress with structured guidance and ongoing accountability.', price: '£20', fee: '+ £50 Set-Up Fee', cta: 'Start Here', col: 1 },
  { name: 'Elite Package', caption: 'Build momentum and achieve faster results with hands-on coaching, regular plan updates, and personal support.', price: '£200', cta: 'Choose Elite', col: 2, popular: true },
];
const stats = [
  { n: 100, label: 'CLIENTS COACHED' },
  { n: 250, label: 'PLANS CREATED' },
  { n: 1000, label: 'SESSIONS DELIVERED' },
  { n: 100, label: 'FIVE STAR REVIEWS' },
];
const storyImages = [
  '/assets/img/about-1.webp', '/assets/img/online-story-1.webp', '/assets/img/online-story-2.webp',
  '/assets/img/online-story-3.webp', '/assets/img/about-5.webp', '/assets/img/about-6.webp',
];
---
<Base
  title="Online Coaching | FordFit App Training & Personalised Plans"
  description="Train anywhere with FordFit Online Coaching. Get custom workouts, nutrition support & weekly check-ins through the FordFit App to see real progress."
>
  <section class="oc-hero">
    <div class="container">
      <p class="oc-kicker">TRAIN ANYWHERE. STAY ACCOUNTABLE.</p>
      <h1 class="oc-title"><span>YOUR ONLINE COACHING JOURNEY</span> <span>— ALL IN THE FORDFIT APP</span></h1>
      <p class="oc-text">Experience professional <strong>online personal training</strong> designed around your lifestyle with the <strong>FordFit App</strong>. Get fully tailored workout and nutrition plans, video-guided exercises, weekly check-ins, and direct communication with Toby — your coach every step of the way. Whether you train at home, in the gym, or on the go, FordFit’s <strong>remote coaching</strong> keeps you accountable and progressing. Achieve real results through flexible, app-based <strong>fitness coaching</strong> built to fit you.</p>
      <div class="oc-video">
        <video autoplay muted loop playsinline preload="metadata" poster="/assets/img/online-hero-poster.webp" aria-label="The FordFit app">
          <source media="(max-width: 767px)" src="/assets/video/online-hero-mobile.mp4" type="video/mp4" />
          <source src="/assets/video/online-hero.mp4" type="video/mp4" />
        </video>
      </div>
    </div>
  </section>

  <section class="oc-plans">
    <div class="container">
      <p class="eyebrow">WHAT WE OFFER ONLINE</p>
      <h2 class="section-title">ONLINE COACHING THAT FITS YOUR LIFESTYLE</h2>
      <p class="oc-plans-intro">Train on your own schedule with <strong>FordFit Online Coaching</strong>. Through the FordFit App, you’ll get personalised workout plans, progress tracking, and ongoing support directly from Toby — no matter where you are. From structured home workouts to gym-based training plans, online coaching gives you the flexibility to stay consistent, accountable, and see lasting results.</p>

      <div class="compare" role="table" aria-label="Online coaching packages">
        <div class="cmp-head cmp-features" role="columnheader"><h3>Features</h3><p>Compare our plans</p></div>
        {plans.map((p) => (
          <div class="cmp-head" role="columnheader" style={`grid-column:${p.col + 1}`}>
            {p.popular && <span class="ribbon">Most Popular</span>}
            <h3>{p.name}</h3>
            <p><em>{p.caption}</em></p>
          </div>
        ))}
        {rows.map(([feature, basic, elite]) => (
          <>
            <div class="cmp-feature" role="rowheader"><strong>{feature}</strong></div>
            <div class="cmp-cell" role="cell">{basic || '—'}</div>
            <div class="cmp-cell" role="cell">{elite}</div>
          </>
        ))}
        <div class="cmp-feature cmp-empty"></div>
        {plans.map((p) => (
          <div class="cmp-foot" style={`grid-column:${p.col + 1}`}>
            <p class="cmp-price">{p.price} <span>/ month</span></p>
            {p.fee && <p class="cmp-fee">{p.fee}</p>}
            <a class="cmp-btn" href={START_URL}>{p.cta}</a>
          </div>
        ))}
      </div>

      <div class="plan-cards">
        {plans.map((p) => (
          <article class="plan-card">
            {p.popular && <span class="ribbon">Most Popular</span>}
            <h3>{p.name}</h3>
            <p class="plan-caption"><em>{p.caption}</em></p>
            <dl>
              {rows.map((r) => (r[p.col] ? <><dt>{r[0]}</dt><dd>{r[p.col]}</dd></> : null))}
            </dl>
            <p class="cmp-price">{p.price} <span>/ month</span></p>
            {p.fee && <p class="cmp-fee">{p.fee}</p>}
            <a class="cmp-btn" href={START_URL}>{p.cta}</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="oc-family">
    <video class="bg-video" autoplay muted loop playsinline preload="metadata" poster="/assets/img/silk-3-poster.webp" aria-hidden="true">
      <source src="/assets/video/silk-3.mp4" type="video/mp4" />
    </video>
    <div class="container">
      <h2 class="oc-h2">JOIN THE FORDFIT FAMILY</h2>
      <div class="stats">
        {stats.map((s) => (
          <div class="stat">
            <p class="stat-n" data-count={s.n} data-suffix="+">{s.n.toLocaleString('en-GB')}+</p>
            <p class="stat-label">{s.label}</p>
          </div>
        ))}
      </div>
      <a class="btn oc-family-btn" href={START_URL}>START YOUR JOURNEY</a>
    </div>
  </section>

  <ReviewsBand id="reviews" bg="var(--smoke)" />

  <section class="oc-story">
    <video class="bg-video" autoplay muted loop playsinline preload="metadata" poster="/assets/img/silk-3-poster.webp" aria-hidden="true">
      <source src="/assets/video/silk-3.mp4" type="video/mp4" />
    </video>
    <div class="container">
      <h2 class="oc-h2">STILL NOT SURE?</h2>
      <p class="oc-story-sub">Get to know Toby better — click below to read his story.</p>
      <StoryGallery images={storyImages} blurred />
    </div>
  </section>
</Base>

<style>
  .oc-hero { background: var(--white); padding: 50px 0 50px; text-align: center; }
  .oc-kicker { font-family: var(--open-sans); font-size: 18px; line-height: 1.3; letter-spacing: 2px; }
  .oc-title { font-family: var(--open-sans); font-size: 37px; font-weight: 900; line-height: 1.3; margin: 12px 0 14px; display: flex; flex-direction: column; align-items: center; }
  .oc-text { font-family: var(--open-sans); font-size: 18px; line-height: 1.3; max-width: 1150px; margin: 0 auto; }
  .oc-video { margin-top: 36px; border-radius: 25px; overflow: hidden; aspect-ratio: 1170 / 602; background: #2b2b2b; }
  .oc-video video { width: 100%; height: 100%; object-fit: cover; }

  .oc-plans { background: var(--smoke); padding: 60px 0; }
  .oc-plans-intro { font-family: var(--poppins); font-size: 17px; line-height: 1.3; text-align: center; max-width: 930px; margin: 14px auto 0; }
  .compare {
    display: grid; grid-template-columns: repeat(3, 1fr); max-width: 1110px; margin: 40px auto 0; background: var(--white);
    border: 1px solid #e4e4e4; font-family: var(--poppins); text-align: center;
  }
  .compare > * { border-bottom: 1px solid #e4e4e4; padding: 16px 14px; display: flex; flex-direction: column; justify-content: center; }
  .compare > :not(:nth-child(3n + 1)) { border-left: 1px solid #e4e4e4; }
  .cmp-head { position: relative; overflow: hidden; min-height: 130px; }
  .cmp-head h3 { font-size: 24px; font-weight: 600; color: #111827; }
  .cmp-head p { font-size: 14px; line-height: 1.4; color: #6b7280; margin-top: 8px; }
  .cmp-features { background: #f8fafc; }
  .cmp-features p { color: #64748b; font-style: normal; }
  .cmp-feature { background: #f8fafc; font-size: 14px; min-height: 73px; }
  .cmp-cell { font-size: 14px; line-height: 1.2; color: #000; min-height: 73px; }
  .plan-cards { display: none; }
  .cmp-empty { background: #f8fafc; border-bottom: 0 !important; }
  .cmp-foot { border-bottom: 0 !important; padding: 24px 14px; }
  .cmp-price { font-size: 40px; font-weight: 700; line-height: 1.2; color: #111827; }
  .cmp-price span { font-size: 13px; font-weight: 400; }
  .cmp-fee { font-size: 14px; font-weight: 600; color: #757bbd; margin-top: 4px; }
  .cmp-btn { display: block; margin-top: 20px; background: var(--black); color: var(--white); border-radius: 4px; padding: 11px 16px; font-size: 16px; font-weight: 700; text-decoration: none; }
  .cmp-btn:hover { opacity: .85; }
  .ribbon {
    position: absolute; top: 22px; right: -52px; width: 198px; transform: rotate(45deg); background: var(--black); color: var(--white);
    font-size: 12px; font-weight: 600; letter-spacing: .5px; text-transform: uppercase; padding: 8px 16px;
  }

  .oc-family, .oc-story { position: relative; overflow: hidden; background: var(--white); text-align: center; }
  .oc-family { padding: 40px 0 50px; }
  .oc-family .container, .oc-story .container { position: relative; z-index: 1; }
  .oc-h2 { font-family: var(--poppins); font-size: 48px; font-weight: 700; line-height: 1.3; }
  .stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; margin: 30px 0 40px; }
  .stat-n { font-family: var(--poppins); font-size: 48px; font-weight: 700; line-height: 1.2; font-variant-numeric: tabular-nums; }
  .stat-label { font-family: var(--open-sans); font-size: 15px; margin-top: 8px; }
  .oc-family-btn { width: min(750px, 100%); background: var(--black); color: var(--white); border: 2px solid var(--white); border-radius: 15px; font-size: 20px; font-weight: 600; padding: 15px 20px; }
  .oc-story { padding: 40px 0 30px; }
  .oc-story-sub { font-family: var(--poppins); font-size: 18px; line-height: 1.3; margin: 12px 0 10px; }

  @media (max-width: 767px) {
    .oc-title { font-size: 26px; }
    .oc-text { font-size: 16px; }
    .oc-video { aspect-ratio: 4 / 5; max-width: 420px; margin-inline: auto; }
    /* One card per plan instead of the comparison table */
    .compare { display: none; }
    .plan-cards { display: grid; gap: 16px; margin-top: 30px; }
    .plan-card { position: relative; overflow: hidden; background: var(--white); border: 1px solid #e4e4e4; border-radius: 16px; padding: 22px 18px; text-align: center; font-family: var(--poppins); }
    .plan-card h3 { font-size: 24px; font-weight: 600; color: #111827; }
    .plan-caption { font-size: 14px; color: #6b7280; margin: 8px 24px 0; }
    .plan-card dl { margin: 16px 0 20px; text-align: left; }
    .plan-card dt { font-size: 14px; font-weight: 700; margin-top: 12px; }
    .plan-card dd { font-size: 14px; margin: 2px 0 0; color: #374151; }
    .oc-h2 { font-size: 32px; }
    .stats { grid-template-columns: 1fr 1fr; }
    .stat-n { font-size: 40px; }
    .oc-family-btn { font-size: 17px; }
  }
</style>
